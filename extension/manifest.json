{
  "manifest_version": 3,
  "name": "🇪🇺 ESA Encyclopedia",
  "version": "1.0",
  "description": "Encyclopédie spatiale ESA — 2370 mots",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ESA Encyclopedia"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"]
  }]
}
